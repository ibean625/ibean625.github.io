---
interface Props { name: 'arrow' | 'external' | 'download' | 'mail' | 'chat' | 'sun' | 'moon' | 'menu' | 'play' | 'up' | 'expand' | 'close'; class?: string; }
const { name, class: className } = Astro.props;
const paths = {
  arrow: 'M4 12h15m-6-6 6 6-6 6',
  external: 'M7 17 17 7M7 7h10v10',
  download: 'M12 3v12m-5-5 5 5 5-5M4 15v5h16v-5',
  mail: 'M3 6h18v13H3zM3 6l9 7 9-7',
  chat: 'M7 3h10a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4h-7l-5 3v-4a4 4 0 0 1-2-3V7a4 4 0 0 1 4-4ZM8 9h.01M16 9h.01M8 13q4 4 8 0',
  sun: 'M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5',
  moon: 'M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z',
  menu: 'M4 6h16M4 12h16M4 18h16',
  play: 'm9 5 10 7-10 7Z',
  up: 'M12 20V4m-6 6 6-6 6 6',
  expand: 'M9 3H3v6m12-6h6v6M3 15v6h6m12-6v6h-6',
  close: 'm6 6 12 12M6 18 18 6',
};
---
<svg class={className} width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d={paths[name]} />
  {name === 'sun' && <circle cx="12" cy="12" r="4" />}
</svg>
