---
import { copy, profile, type Locale } from '../data/site';
import Icon from './Icon.astro';
import LetterEnvelope from './LetterEnvelope.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale].messageForm;
const action = `https://formsubmit.co/${profile.messageFormId}`;
const formUrl = `${profile.url}${locale === 'zh' ? '/zh/' : '/'}#message`;
---
<a id="message" class="message-launcher" href={`mailto:${profile.email}`} data-open-message aria-haspopup="dialog" aria-controls="message-dialog" aria-label={t.open} title={t.invitation}><LetterEnvelope /></a>
<dialog id="message-dialog" class="message-dialog" aria-labelledby="message-title" aria-describedby="message-privacy" data-phase="closed">
  <div class="letter-scene">
    <button class="icon-button letter-close" type="button" data-close-message aria-label={t.close} autofocus><Icon name="close" /></button>
    <div class="letter-dock" data-letter-dock></div>
    <div class="message-dialog-panel letter-sheet" hidden inert>
    <header class="message-dialog-header">
      <div data-message-compose-heading>
        <h2 id="message-title">{t.title}</h2>
      </div>
    </header>
    <form class="message-form" action={action} method="POST" enctype="multipart/form-data" data-endpoint={`https://formsubmit.co/ajax/${profile.messageFormId}`} data-recipient={profile.email} data-sending={t.sending} data-success={t.success} data-error={t.error} data-required={t.required} data-file-limit={t.fileLimit} data-remove-file={t.removeFile} aria-describedby="message-privacy">
      <input type="hidden" name="_subject" value={t.mailSubject} />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="_url" value={formUrl} />
      <div class="message-trap" aria-hidden="true"><label>Website<input type="text" name="_honey" tabindex="-1" autocomplete="off" /></label></div>
      <fieldset class="message-fields">
        <div class="message-field">
          <label for="message-contact">{t.contact}</label>
          <input id="message-contact" type="text" name="contact" autocomplete="off" maxlength="254" required placeholder={t.contactPlaceholder} />
        </div>
        <div class="message-field message-content">
          <label for="message-content">{t.content}</label>
          <textarea id="message-content" name="message" rows="5" maxlength="5000" required placeholder={t.contentPlaceholder}></textarea>
        </div>
      </fieldset>
      <ul class="letter-attachments" aria-label={t.attachments} data-attachment-list></ul>
      <div class="message-submit-row">
        <div class="letter-attachment-control">
          <button class="letter-attach" type="button" data-add-attachment><Icon name="attachment" />{t.attachments}</button>
          <span>{t.attachmentHint}</span>
          <input type="file" name="attachment" multiple hidden data-attachment-input aria-label={t.attachments} />
        </div>
        <button class="message-submit" type="submit" data-label={t.submit}>{t.submit}</button>
      </div>
      <p class="message-status" role="status" aria-live="polite" tabindex="-1" hidden></p>
      <p class="message-privacy" id="message-privacy">{t.privacy}</p>
      <p class="message-alternative" hidden data-error-email><a href={`mailto:${profile.email}`}>{t.alternative}</a></p>
    </form>
    </div>
    <div class="letter-receipt-wrap">
    <section class="message-thanks" hidden tabindex="-1" aria-labelledby="message-thanks-title" aria-describedby="message-thanks-description">
      <span class="letter-delivered" aria-hidden="true">✓</span>
      <div role="status" aria-live="polite">
        <p class="message-thanks-delivery">{t.success}</p>
        <h2 id="message-thanks-title">{t.thanksTitle}</h2>
        <p class="message-thanks-text" id="message-thanks-description">{t.thanksText}</p>
      </div>
      <button class="message-submit" type="button" data-close-message>{t.thanksClose}</button>
    </section>
    </div>
  </div>
</dialog>
<script>
  import '../scripts/message-form';
</script>
