#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

export ASTRO_TELEMETRY_DISABLED=1
preview_host="${HOST:-127.0.0.1}"
preview_port="${PORT:-4100}"

if [ ! -d node_modules/astro ]; then
  npm ci
fi

echo "Serving local preview at http://${preview_host}:${preview_port}"
npm run dev -- --host "$preview_host" --port "$preview_port"
